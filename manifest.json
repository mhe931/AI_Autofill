{
  "manifest_version": 3,
  "name": "AI Form Filler",
  "version": "1.1",
  "description": "Form extraction and filling for Chrome and Microsoft Edge.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "clipboardRead",
    "clipboardWrite",
    "unlimitedStorage"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon16.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}